{
  "name": "@poyoapi/cli",
  "version": "0.1.0",
  "description": "Catalog-driven CLI for PoYo chat and media-generation models",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PoyoAPI/poyo-devtools.git",
    "directory": "packages/cli"
  },
  "homepage": "https://poyo.ai/",
  "bugs": {
    "url": "https://github.com/PoyoAPI/poyo-devtools/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {"poyo": "./dist/bin.js"},
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {"access": "public"},
  "engines": {"node": ">=20"},
  "dependencies": {
    "@poyoapi/core": "workspace:*",
    "@poyoapi/mcp": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
